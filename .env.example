# ==============================================================================
# MUSICFY - TEMPLAT ENVIRONMENT VARIABLES (.env.example)
# Salin berkas ini menjadi .env.production atau .env.local:
#   cp .env.example .env.production
#   (atau cp .env.example .env.local untuk pengujian lokal)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI SERVER & PORT DINAMIS
# ------------------------------------------------------------------------------
# Port listening server Next.js (Ganti nilai ini ke 3000, 4000, 8080, dll)
PORT=6000

# Hostname listening server Next.js (0.0.0.0 untuk semua interface/LAN, atau localhost)
HOSTNAME=0.0.0.0

# Public Application URL (URL utama aplikasi untuk browser & client)
# Sesuaikan port jika mengubah PORT di atas (misal: http://localhost:4000)
NEXT_PUBLIC_APP_URL=http://localhost:6000

# Kompatibilitas domain publik lama
NEXT_PUBLIC_BASE_URL=http://localhost:6000

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Pencarian Cerdas & Terjemahan Lirik)
# ------------------------------------------------------------------------------
# API Key resmi Google Gemini (Dapatkan gratis di https://aistudio.google.com)
GEMINI_API_KEY=
# Model Gemini yang digunakan (Opsional, default: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. MODE ADMIN RAHASIA (SECRET ADMIN TELEMETRY)
# ------------------------------------------------------------------------------
# Kata sandi untuk membuka panel telemetry & manajemen cache di halaman /settings
ADMIN_PASSWORD=shanz1

# Kunci rahasia (salt) untuk menandatangani token sesi admin (Disarankan hex 32-karakter acak)
# Buat dengan: openssl rand -hex 32
ADMIN_JWT_SECRET=8ae38eb4fd5999bf9f194553356ba6ae4ebaff4cd57864a7c8108fd4f35cf606

# ------------------------------------------------------------------------------
# 4. MEILISEARCH SEARCH ENGINE (<50ms Typo-Tolerant Search)
# ------------------------------------------------------------------------------
# Alamat host instance Meilisearch (default lokal: http://127.0.0.1:7700)
MEILISEARCH_HOST=http://127.0.0.1:7700

# Master API Key Meilisearch (Wajib sama dengan konfigurasi docker-compose / systemd)
# Buat dengan: openssl rand -hex 24
MEILISEARCH_API_KEY=6146abad7bfffc991768445bdc3ee8d52573b1457f864f72

# Nama index lagu di Meilisearch (Opsional, default: musicfy_tracks)
MEILISEARCH_INDEX_NAME=musicfy_tracks

# ------------------------------------------------------------------------------
# 5. UMAMI ANALYTICS (Telemetri Pengunjung Ringan & Anti-Adblock)
# ------------------------------------------------------------------------------
# Kata sandi database PostgreSQL internal untuk container Docker Umami
UMAMI_DB_PASSWORD=

# Kunci rahasia internal aplikasi Umami (Disarankan hex acak)
UMAMI_APP_SECRET=

# URL script tracking publik (Umami Cloud Script)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Website ID unik dari dashboard Umami Cloud
NEXT_PUBLIC_UMAMI_WEBSITE_ID=5f86e200-da84-4492-b697-82aa697b25c2

# ------------------------------------------------------------------------------
# 6. ENGINE SCRAPING YT-DLP, FFMPEG & DENO RESILIENCE
# ------------------------------------------------------------------------------
# Batas maksimal proses yt-dlp berjalan serentak (mencegah lonjakan CPU VPS & rate-limit)
MAX_CONCURRENT_YTDLP=3

# Custom path eksekusi binary (Opsional, default mendeteksi otomatis di PATH/sistem)
YTDLP_PATH=
FFMPEG_PATH=
DENO_PATH=

# Cookie YouTube untuk mencegah bot verification (Opsional, format Netscape Base64 atau raw)
# Anda juga dapat meletakkan file cookies.txt langsung di root folder proyek
YT_COOKIES_BASE64=
YTDLP_COOKIES=

# Jumlah permintaan sebelum merotasi file sesi cookies secara otomatis (default: 5)
COOKIE_ROTATION_BATCH_SIZE=5

# Strategi pemilihan cookie: 'rotate' (round-robin per batch) atau 'random' (pengacak acak setiap request)
COOKIE_SELECTION_STRATEGY=rotate

# ------------------------------------------------------------------------------
# 7. TAUTAN UNDUHAN APLIKASI ANDROID (APK)
# ------------------------------------------------------------------------------
# Tautan unduhan langsung berkas APK (Google Drive, GitHub Releases, MediaFire, dll)
NEXT_PUBLIC_APK_DOWNLOAD_URL=Ob/view?usp=sharing
